# Database
# NOTE: docker-compose maps the Postgres container's 5432 to host port 5433
# (to avoid clashing with a local Postgres install). DB_HOST/DB_PORT below
# must match that mapping, and DATABASE_URL must use the same port.
#
# DATABASE_URL is authoritative: the backend prefers it over DB_HOST/DB_PORT/
# POSTGRES_* (which stay as the fallback), and the Python trainer and every
# loader script read it and nothing else. Keeping the two in sync matters --
# when they disagreed, setting DATABASE_URL moved Python to one database and
# left the backend on another, which is how a load run once wrote 160 test
# accounts into the shared dev database.
POSTGRES_USER=movieapp
POSTGRES_PASSWORD=dev_password_change_in_production
POSTGRES_DB=moviedb
DB_HOST=127.0.0.1
DB_PORT=5433
DATABASE_URL=postgresql://movieapp:dev_password_change_in_production@localhost:5433/moviedb

# API
API_PORT=3101
API_ENV=development
NODE_ENV=development
# Reverse-proxy hops Express trusts when resolving the real client IP from
# X-Forwarded-For (M10, throttling keyed by the wrong address behind a
# proxy). 1 = a single proxy directly in front of the app -- correct for
# every hosting topology these docs describe; raise it only if a real
# deployment chain adds another hop (e.g. CDN + load balancer).
TRUST_PROXY_HOPS=1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3101/api

# Anthropic (enrichment worker only; the core loop never needs it).
# Leave the key line out or empty to use an `ant auth login` profile instead;
# an exported ANTHROPIC_API_KEY in the shell takes precedence over this file.
ANTHROPIC_API_KEY=
# Only for an identity-linked key (the API answers 400 "anthropic-workspace-id
# is required" without it): the id of the workspace the key acts in, from the
# Console's workspace settings. Leave empty for an ordinary workspace key.
ANTHROPIC_WORKSPACE_ID=
# Model ids are configuration, never hard-coded (ADR-6). Required by
# services/workers/src/enrichment.py -- FilmEnrichmentWorker raises if unset.
ANTHROPIC_FINGERPRINT_MODEL=claude-opus-5
ANTHROPIC_EXPLANATION_MODEL=claude-opus-5

# Poster images (board C-2 / archive B4): TMDB API v3 key, sent as a query
# param on GET /movie/{id} -- never scraping. Empty locally disables
# fetch-tmdb-posters.ts; the owner sets this in the root .env.
TMDB_API_KEY=

# Model-call accounting (board request G7, owner's decision 2026-09-04): every
# enrichment call appends one JSON line (tokens, models, latency, status; never
# prompt text) to $LLM_CALL_LOG_DIR/<runId>.jsonl -- default <os tmp>/movie-llm-calls,
# outside git. Cost is derived only when LLM_PRICES_JSON names prices for the
# served model, e.g. {"claude-sonnet-5": {"inputPerMTok": 3, "outputPerMTok": 15}};
# otherwise costUsd stays null and a later study computes it from the tokens.
LLM_CALL_LOG_DIR=
LLM_PRICES_JSON=

# Model service (ADR-25; ALPHA_PLAN phase 1). The backend asks it to train a
# profile after TRAINING_FIRST_TRIAD_COUNT completed triads and every
# TRAINING_EVERY_N_TRIADS after that. Leave MODEL_SERVICE_URL empty to disable
# the automatic trigger (training then stays the manual
# `python -m src.training <profileId>`). Start it with `make model-service`.
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_HOST=127.0.0.1
MODEL_SERVICE_PORT=8001
# Shared secret between backend and model service. When set, the backend sends
# it as a Bearer token and the service rejects requests without it; the
# service refuses to bind anywhere but loopback while it is empty.
MODEL_SERVICE_TOKEN=
TRAINING_FIRST_TRIAD_COUNT=3
TRAINING_EVERY_N_TRIADS=5

# Privacy rights (PRIVACY.md §5, §10; ALPHA_PLAN phase 2). A deletion request is
# scheduled PRIVACY_DELETE_SAFETY_DAYS ahead (0 = purge immediately) and can be
# cancelled until then; a sweep every PRIVACY_SWEEP_INTERVAL_MS purges what is
# due (0 = an external scheduler calls it). Client addresses in audit_log are
# stored as a salted hash; set AUDIT_IP_SALT to a random string in production.
PRIVACY_DELETE_SAFETY_DAYS=7
PRIVACY_SWEEP_INTERVAL_MS=60000
AUDIT_IP_SALT=

# JWT (ADR-26). The secret must be a random value of at least 32 characters;
# the placeholder below is refused in production and warned about elsewhere.
JWT_SECRET=your_jwt_secret_key_change_in_production
# Access tokens are short-lived; clients renew them with POST /auth/refresh.
# Refresh tokens rotate on every use and live JWT_REFRESH_TTL_DAYS.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Full TypeORM query logging (prints parameters, including password hashes on
# insert) is opt-in; errors, warnings and migrations are always logged.
DB_LOG_QUERIES=false

# Application
APP_NAME=MovieRecommendation
APP_VERSION=0.1.0

# IMDb ratings loader (ALPHA_PLAN 5.3, DATA_LICENSING.md §3.2): where the
# official title.ratings.tsv.gz dump is kept (default: <os tmp>/movie-imdb-datasets,
# never inside the repo) and where `--fetch` downloads it from.
# IMDB_DATASETS_DIR=
# IMDB_RATINGS_URL=https://datasets.imdbws.com/title.ratings.tsv.gz
# In-app periodic refresh of the same dump (0 or unset = off; 168 = weekly). The
# app downloads and reloads when the newest stored value is older than this.
# IMDB_REFRESH_INTERVAL_HOURS=168

# Mail (ALPHA_PLAN 3.2; ADR-85, ADR-95 and the owner's mail decision of
# 2026-09-05). MAIL_TRANSPORT picks the delivery: 'log' (default outside
# production, REFUSED in production) writes the message to the server log and
# sends nothing; 'resend' posts to Resend's HTTPS API (owner decision O-3;
# works on every Railway plan) and needs RESEND_API_KEY + MAIL_FROM_ADDRESS on
# a domain verified there (kolme.app; DNS records are board C-20); 'smtp'
# reaches any SMTP relay -- the VPS path; Railway allows outbound SMTP on Pro
# only -- with SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD, 465 = implicit TLS,
# otherwise STARTTLS, required whenever credentials are set. A transport
# missing its key, server or sender refuses to boot: one that accepts a
# password-reset request and silently sends nothing is worse than one that
# will not start. Never commit a real key or password.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Every message is a mail_outbox row (ADR-97): sent at once, retried by a
# sweep with backoff on failure. Interval in ms; 0 = off (an external
# scheduler would call it), and the test suite never arms it.
MAIL_OUTBOX_SWEEP_INTERVAL_MS=30000
# How long a password-reset link stays usable.
PASSWORD_RESET_TTL_MINUTES=30

# Observability (ALPHA_PLAN 7.5, ADR-86). The SDKs are installed; both stay
# OFF unless the matching variable below is set, and neither can fail a boot.
# Set them as Railway variables in staging/prod (ADR-88) -- never commit a
# real DSN here. OTEL_EXPORTER_OTLP_ENDPOINT is the full traces URL, e.g.
# http://collector:4318/v1/traces. A DSN Sentry cannot parse is reported as
# OFF in the boot log rather than silently swallowing every error report.
# First-party product analytics needs neither: it writes to analytics_events
# in this database, and only for a profile that granted analytics_first_party.
SENTRY_DSN=
# Railway sets RAILWAY_GIT_COMMIT_SHA on every deploy already -- only set this
# on a host that does not (P0-3).
SENTRY_RELEASE=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=reel-backend
OTEL_TRACES_SAMPLE_RATE=1
