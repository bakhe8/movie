# Non-secret config for docker-compose.prod.yml (board C-5). Copy to
# `docker/.env.prod` (gitignored) and fill in; secrets go in docker/secrets/
# instead (see docker/secrets/*.txt.example), never in this file.

NEXT_PUBLIC_API_URL=https://api.example.com/api

POSTGRES_USER=movieapp
POSTGRES_DB=moviedb

ANTHROPIC_FINGERPRINT_MODEL=claude-opus-5
ANTHROPIC_EXPLANATION_MODEL=claude-opus-5
ANTHROPIC_WORKSPACE_ID=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
TRUST_PROXY_HOPS=1

PRIVACY_DELETE_SAFETY_DAYS=7
PRIVACY_SWEEP_INTERVAL_MS=60000

TRAINING_FIRST_TRIAD_COUNT=3
TRAINING_EVERY_N_TRIADS=5
