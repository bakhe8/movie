{
  "name": "@movie/backend",
  "version": "0.1.0",
  "description": "NestJS backend for movie recommendation system",
  "author": "Movie Team",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run build && node dist/main.js",
    "build": "tsc",
    "seed": "npm run build && node dist/scripts/seed.js",
    "seed:demo": "npm run build && node dist/scripts/seed-demo.js",
    "seed:demo:clean": "npm run build && node dist/scripts/seed-demo.js --clean",
    "catalog:fetch": "tsx src/scripts/fetch-catalog.ts",
    "admin:grant": "npm run build && node dist/scripts/grant-admin.js",
    "start": "node dist/main.js",
    "lint": "eslint src/",
    "test": "vitest run -c vitest.config.ts",
    "test:cov": "vitest run -c vitest.config.ts --coverage",
    "test:e2e:up": "docker compose --project-directory ../.. -f ../../docker/docker-compose.yml up -d postgres-test",
    "test:e2e:migrate": "node scripts/migrate-test-db.js",
    "test:e2e": "npm run test:e2e:up && npm run test:e2e:migrate && vitest run -c vitest.e2e.config.ts",
    "typeorm": "node scripts/typeorm-cli.js -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migrate": "npm run migration:run"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.1",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.56.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.7"
  }
}
